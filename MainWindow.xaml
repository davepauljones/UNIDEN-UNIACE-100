                <Border CornerRadius="35" BorderThickness="8" BorderBrush="Silver" Width="51" Height="51"/>
            </Canvas>

            <Canvas Name="TXLEDBorder" Canvas.Left="1258" Canvas.Top="46" Opacity="0.5">
