<controls:MetroWindow x:Class="UNIDEN_UNIACE_100.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UNIDEN_UNIACE_100"
        mc:Ignorable="d" 
        xmlns:controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:fa="clr-namespace:FontAwesome.WPF;assembly=FontAwesome.WPF"
        xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:channelDisplay="clr-namespace:UNIDEN_UNIACE_100"
        Background="Transparent" Topmost="True" WindowStyle="None" BorderThickness="0" SaveWindowPosition="True"
        ShowTitleBar="False" ShowMinButton="False" ShowMaxRestoreButton="False" ShowCloseButton="False"
        Title="MainWindow" Width="1339" Height="360" SizeToContent="Height">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="360"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Your Uniden Radio Interface Canvas -->
        <Canvas x:Name="RigCanvas" Grid.Row="0" Width="1339" Height="360" MouseDown="RigCanvas_MouseDown">
