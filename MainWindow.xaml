                <ImageBrush Opacity="0.0" ImageSource="pack://application:,,,/Images/unidenuniace100.png" Stretch="None" AlignmentY="Top" AlignmentX="Left"/>
            </Canvas.Background>

            <Canvas Name="OuterBorder" Canvas.Left="0" Canvas.Top="0">
                <Border CornerRadius="5" BorderThickness="12" BorderBrush="Silver" Width="1339" Height="360"/>
            </Canvas>

            <Canvas Name="LeftRectangle" Canvas.Left="12" Canvas.Top="12" Opacity="0.9">
                <Rectangle Fill="Gray" Width="250" Height="336"/>
            </Canvas>

            <Canvas Name="SQBorder" Canvas.Left="72" Canvas.Top="34" Opacity="0.9">
                <Border CornerRadius="70" BorderThickness="4" BorderBrush="Silver" Background="#66333333" Width="130" Height="130"/>
            </Canvas>

            <Canvas Name="SQText" Canvas.Left="204" Canvas.Top="126" Opacity="0.9">
                <TextBlock Text="SQ" Foreground="Black" FontSize="26" FontWeight="Bold" FontFamily="Arial"/>
            </Canvas>

            <Canvas Name="VOLBorder" Canvas.Left="72" Canvas.Top="202" Opacity="0.9">
                <Border CornerRadius="70" BorderThickness="4" BorderBrush="Silver" Background="#66333333" Width="130" Height="130"/>
            </Canvas>

            <Canvas Name="OFFText" Canvas.Left="32" Canvas.Top="307" Opacity="0.9">
                <TextBlock Text="OFF" Foreground="Black" FontSize="24" FontWeight="Bold" FontFamily="Arial"/>
            </Canvas>

            <Canvas Name="VOLText" Canvas.Left="196" Canvas.Top="307" Opacity="0.9">
                <TextBlock Text="VOL" Foreground="Black" FontSize="24" FontWeight="Bold" FontFamily="Arial"/>
            </Canvas>

            <Canvas Name="InnerBorder" Canvas.Left="258" Canvas.Top="12" Opacity="0.9">
                <Border BorderThickness="14" BorderBrush="Silver" Width="672" Height="336"/>
            </Canvas>

            <Canvas Name="BlackRectangle" Canvas.Left="268" Canvas.Top="26" Opacity="0.4">
                <Rectangle Fill="Black" Width="652" Height="308"/>
