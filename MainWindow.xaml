            <Canvas Name="LEDTXText" Canvas.Left="1259" Canvas.Top="90" Opacity="0.9">
                <TextBlock Text="TX" Foreground="Black" FontSize="22" FontWeight="Bold" FontFamily="Miriam Libre"/>
            </Canvas>

            <Canvas Name="Uniace100Text" Canvas.Left="1030" Canvas.Top="308" Opacity="0.9">
                <TextBlock Text="UNIACE 100" Foreground="Black" FontSize="34" FontWeight="Bold" FontFamily="Miriam Libre"/>
            </Canvas>
        </Canvas>

        <!-- Row 1: WebView2 Control placed directly in Grid Row 1 -->
