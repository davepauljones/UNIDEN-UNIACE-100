<UserControl x:Class="UNIDEN_UNIACE_100.ChannelDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UNIDEN_UNIACE_100"
             xmlns:sevensegmentdisplay="clr-namespace:UNIDEN_UNIACE_100"
             mc:Ignorable="d" 
             d:DesignHeight="106" d:DesignWidth="182">

    <!-- Changed: Viewbox is now the root element so the whole layout scales to any size -->
    <Viewbox x:Name="ChannelViewBox" Stretch="Uniform">
        <!-- Changed: Expanded Width to 1160 so Digit 8 sitting at Left 1020 fits nicely -->
        <Canvas Width="250" Height="160">

            <sevensegmentdisplay:SevenSegmentDisplay x:Name="Digit_1" Canvas.Left="0" Canvas.Top="0" HexDigit="One"/>
            <sevensegmentdisplay:SevenSegmentDisplay x:Name="Digit_2" Canvas.Left="140" Canvas.Top="0" HexDigit="Four" Dot="On"/>

        </Canvas>
    </Viewbox>
</UserControl>
